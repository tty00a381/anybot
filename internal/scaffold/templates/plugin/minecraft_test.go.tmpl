package {{.Package}}

import (
	"context"
	"strings"
	"testing"

	absdk "github.com/tty00a381/anybot/sdk"
	"github.com/tty00a381/anybot/sdk/message"
)

func TestModuleStoresPlayerBinding(t *testing.T) {
	client := &recordClient{}
	app := absdk.NewApp(
		absdk.WithAdapter(recordAdapter{client: client}),
		absdk.WithDataDir(t.TempDir()),
		absdk.WithSuperUsers("admin"),
	)
	if err := app.UsePlugin(absdk.AsPlugin(Module)); err != nil {
		t.Fatal(err)
	}
	if err := app.Dispatch(context.Background(), &absdk.Event{
		Protocol: absdk.ProtocolOneBot11,
		SelfID:   "bot",
		Type:     "message",
		UserID:   "admin",
		GroupID:  "1000",
		Text:     "/{{.Command}} bind 10001 Steve",
	}); err != nil {
		t.Fatal(err)
	}
	if got := client.last.Text(); !strings.Contains(got, "已绑定 10001 -> Steve") {
		t.Fatalf("reply = %q", got)
	}
	if err := app.Dispatch(context.Background(), &absdk.Event{
		Protocol: absdk.ProtocolOneBot11,
		SelfID:   "bot",
		Type:     "message",
		UserID:   "admin",
		GroupID:  "1000",
		Text:     "/{{.Command}} who Steve",
	}); err != nil {
		t.Fatal(err)
	}
	if got := client.last.Text(); !strings.Contains(got, "Steve 绑定 QQ 10001") {
		t.Fatalf("reply = %q", got)
	}
}

