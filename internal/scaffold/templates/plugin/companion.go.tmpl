package {{.Package}}

import (
	"fmt"
	"strings"
	"time"

	absdk "github.com/tty00a381/anybot/sdk"
)

// Config 配置 {{.Name}} 人格化聊天插件。
type Config struct {
	Command       string   `yaml:"command"`
	BotName       string   `yaml:"bot_name"`
	Persona       string   `yaml:"persona"`
	AllowedGroups []string `yaml:"allowed_groups"`
	MemoryTTL     string   `yaml:"memory_ttl"`
}

// Validate 校验 {{.Name}} 插件配置。
func (cfg Config) Validate() error {
	if strings.TrimSpace(cfg.Command) == "" {
		return fmt.Errorf("command 不能为空")
	}
	if strings.TrimSpace(cfg.BotName) == "" {
		return fmt.Errorf("bot_name 不能为空")
	}
	if strings.TrimSpace(cfg.Persona) == "" {
		return fmt.Errorf("persona 不能为空")
	}
	if _, err := cfg.memoryTTL(); err != nil {
		return err
	}
	return nil
}

func (cfg Config) memoryTTL() (time.Duration, error) {
	ttl, err := time.ParseDuration(strings.TrimSpace(cfg.MemoryTTL))
	if err != nil {
		return 0, fmt.Errorf("memory_ttl 无效: %w", err)
	}
	if ttl <= 0 {
		return 0, fmt.Errorf("memory_ttl 必须大于 0")
	}
	return ttl, nil
}

// Plugin 是 {{.Name}} 插件导出的 AnyBot 插件定义。
var Plugin = absdk.Define(
	absdk.Manifest{Name: "{{.Manifest}}", Version: "0.1.0", Description: "{{.Name}} 人格化聊天插件"},
	Config{
		Command:       "{{.Command}}",
		BotName:       "{{.Name}}",
		Persona:       "温和、敏锐、少说套话，像一个认真听人讲话的群友。",
		AllowedGroups: nil,
		MemoryTTL:     "12h",
	},
	func(ctx *absdk.Context, cfg Config) error {
		ctx.Command(cfg.Command).Handle(func(c *absdk.EventContext) error {
			_, err := c.ReplyText(fmt.Sprintf("%s 在。直接私聊我，或在群里 @ 我就能聊天。", cfg.BotName))
			return err
		})

		ctx.OnMessage(absdk.AllowedGroups(cfg.AllowedGroups...), absdk.ToMe(), absdk.Not(absdk.CommandRule())).
			Handle(func(c *absdk.EventContext) error {
				return handleCompanionMessage(ctx, cfg, c)
			})
		return nil
	},
)

type conversationMemory struct {
	Turns        int    `json:"turns"`
	LastUserText string `json:"last_user_text,omitempty"`
}

func handleCompanionMessage(ctx *absdk.Context, cfg Config, c *absdk.EventContext) error {
	text := strings.TrimSpace(c.Text())
	if text == "" {
		return absdk.ErrPass
	}
	ttl, err := cfg.memoryTTL()
	if err != nil {
		return err
	}
	session := ctx.UserSession(c)
	var memory conversationMemory
	if _, err := session.LoadJSON(c.Context, "conversation", &memory); err != nil {
		return err
	}
	memory.Turns++
	memory.LastUserText = text
	if err := session.SaveJSON(c.Context, "conversation", memory, ttl); err != nil {
		return err
	}
	_, err = c.ReplyText(renderCompanionReply(cfg, memory, text))
	return err
}

func renderCompanionReply(cfg Config, memory conversationMemory, text string) string {
	persona := strings.TrimSpace(cfg.Persona)
	if memory.Turns <= 1 {
		return fmt.Sprintf("%s：我在听。%s你刚才说「%s」，我先记下来了。", cfg.BotName, personaLead(persona), text)
	}
	return fmt.Sprintf("%s：我还记得我们刚才已经聊了 %d 轮。你这句「%s」我接住了。", cfg.BotName, memory.Turns, text)
}

func personaLead(persona string) string {
	if persona == "" {
		return ""
	}
	return "我会按这个状态陪你聊：" + persona + "。"
}
