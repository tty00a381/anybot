func TestModuleRepliesToCommand(t *testing.T) {
	client := &recordClient{}
	app := absdk.NewApp(absdk.WithAdapter(recordAdapter{client: client}))
	if err := app.UsePlugin(absdk.AsPlugin(Module)); err != nil {
		t.Fatal(err)
	}
	err := app.Dispatch(context.Background(), &absdk.Event{
		Protocol: absdk.ProtocolOneBot11,
		SelfID:   "bot",
		Type:     "message",
		UserID:   "user",
		Text:     "/{{.Command}}",
	})
	if err != nil {
		t.Fatal(err)
	}
	if got := client.last.Text(); got != "{{.Name}} 已启动" {
		t.Fatalf("reply = %q", got)
	}
}

